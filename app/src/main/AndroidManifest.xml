<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        WebDAV 同步（v7.2）。
        INTERNET：唯一的网络权限（普通权限，安装即授予，无需运行时申请）。
        FOREGROUND_SERVICE / FOREGROUND_SERVICE_DATA_SYNC：同步期间用前台服务承载
        （通知栏进度条 + 进程不被回收），dataSync 类型是 Android 14+ 的强制要求。
        POST_NOTIFICATIONS：Android 13+ 显示进度条需要（用户拒绝时同步照跑，只是没有通知栏反馈）。
        刻意**不申请** ACCESS_NETWORK_STATE：失败即报错，少一个权限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        tools:ignore="UnusedAttribute"：networkSecurityConfig 只对 API 24+ 生效，
        minSdk 21 下 API 21~23 会忽略它 —— 这正是预期行为（这几个版本默认就信任用户 CA，
        且默认允许明文），无需为它们做任何兼容处理。
    -->
    <application
        android:name=".HelloWidgetApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HelloWorld"
        tools:ignore="UnusedAttribute">

        <!--
            configChanges="uiMode"：系统深色模式切换时不自动重建 Activity，
            改由 onConfigurationChanged 处理：先触发一次自动保存，再重建应用新主题。

            windowSoftInputMode="adjustResize"：WindowInsetsCompat 官方推荐的设置——
            API 30 以下只有声明 adjustResize，系统才会把输入法高度报给应用
            （WindowInsetsCompat.Type.ime()），本版的「自动弹出输入法」靠它把内容顶到键盘之上。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!--
            WebDAV 同步设置页（地址/凭据/状态/冲突处理）。
            windowSoftInputMode="adjustResize"：本页有输入框，与编辑页同理 ——
            API 30 以下只有声明 adjustResize，系统才会把输入法高度报给应用
            （WindowInsetsCompat.Type.ime()），应用据此把表单顶到键盘之上。
        -->
        <activity
            android:name=".SyncActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            同步前台服务：dataSync 类型 → 需要 FOREGROUND_SERVICE_DATA_SYNC 权限（API 34+）。
            只在真正同步时启动，同步结束立即 stopSelf，不做任何常驻/周期任务。
        -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            通知栏动作（覆盖云端 / 用云端覆盖本地）的接收者。
            exported="false"：只有本应用自己发出的 PendingIntent 能触发它。
        -->
        <receiver
            android:name=".SyncActionReceiver"
            android:exported="false" />

        <!--
            小组件 Provider。exported="false"：系统仍可投递 APPWIDGET_UPDATE
            （系统不受 exported 限制），但第三方应用无法伪造该广播。
            与 Android Studio 官方 App Widget 模板一致。
        -->
        <receiver
            android:name=".TextWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            小组件数据服务：绑定式服务，仅当桌面渲染小组件时被临时启动，
            渲染结束后即停止，不常驻后台。
        -->
        <service
            android:name=".TextWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>
