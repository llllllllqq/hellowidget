<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        WebDAV 同步（v7.2）。
        INTERNET：唯一的网络权限（普通权限，安装即授予，无需运行时申请）。
        FOREGROUND_SERVICE / FOREGROUND_SERVICE_DATA_SYNC：同步期间用前台服务承载
        （通知栏进度条 + 进程不被回收），dataSync 类型是 Android 14+ 的强制要求。
        POST_NOTIFICATIONS：Android 13+ 显示进度条需要（用户拒绝时同步照跑，只是没有通知栏反馈）。
        RECEIVE_BOOT_COMPLETED：v7.9 起的系统重试任务用 setPersisted(true)，这是它的前置权限
        （只声明权限，不注册任何开机广播接收器 —— 我们不需要在开机时做任何事）。
        ACCESS_NETWORK_STATE：v7.9 起系统重试任务带「有网络才执行」的约束，而
        JobSchedulerService.enforceValidJobRequest 明确要求：带 connectivity 约束的任务，
        调用方必须持有该权限，否则 schedule() 直接抛 SecurityException
        （CI 真机日志实测："android.permission.ACCESS_NETWORK_STATE required for jobs with a
        connectivity constraint"）。这是 normal 级权限，安装即授予、无运行时弹窗、不涉及隐私；
        代价是 v7.2~v7.8「一个网络权限都不要」的说法到此为止 —— 换取的是"保存了却没传上去"
        能有一条系统级自愈通道。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        tools:ignore="UnusedAttribute"：networkSecurityConfig 只对 API 24+ 生效，
        minSdk 21 下 API 21~23 会忽略它 —— 这正是预期行为（这几个版本默认就信任用户 CA，
        且默认允许明文），无需为它们做任何兼容处理。
    -->
    <application
        android:name=".HelloWidgetApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HelloWorld"
        tools:ignore="UnusedAttribute">

        <!--
            configChanges="uiMode"：系统深色模式切换时不自动重建 Activity，
            改由 onConfigurationChanged 处理：先触发一次自动保存，再重建应用新主题。

            windowSoftInputMode="adjustResize"：WindowInsetsCompat 官方推荐的设置——
            API 30 以下只有声明 adjustResize，系统才会把输入法高度报给应用
            （WindowInsetsCompat.Type.ime()），本版的「自动弹出输入法」靠它把内容顶到键盘之上。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!--
            WebDAV 同步设置页（地址/凭据/状态/冲突处理）。
            windowSoftInputMode="adjustResize"：本页有输入框，与编辑页同理 ——
            API 30 以下只有声明 adjustResize，系统才会把输入法高度报给应用
            （WindowInsetsCompat.Type.ime()），应用据此把表单顶到键盘之上。
        -->
        <activity
            android:name=".SyncActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            同步前台服务：dataSync 类型 → 需要 FOREGROUND_SERVICE_DATA_SYNC 权限（API 34+）。
            只在真正同步时启动，同步结束立即 stopSelf，不做任何常驻/周期任务。
        -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            v7.9：保存后没能上传成功时的系统级兜底 —— JobScheduler 的一次性持久化任务。
            android:permission="android.permission.BIND_JOB_SERVICE"：只有系统能绑定它，
            否则任何应用都能伪造一次"同步"请求。
            setPersisted(true) 需要 RECEIVE_BOOT_COMPLETED 权限（见上方 uses-permission），
            否则 JobInfo.Builder.build() 会直接抛异常。不显示任何通知，只把欠的上传补上。
        -->
        <service
            android:name=".SyncRetryJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            小组件 Provider。exported="false"：系统仍可投递 APPWIDGET_UPDATE
            （系统不受 exported 限制），但第三方应用无法伪造该广播。
            与 Android Studio 官方 App Widget 模板一致。
        -->
        <receiver
            android:name=".TextWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
            小组件数据服务：绑定式服务，仅当桌面渲染小组件时被临时启动，
            渲染结束后即停止，不常驻后台。
        -->
        <service
            android:name=".TextWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>

</manifest>
