<?xml version="1.0" encoding="utf-8"?>
<!--
    编辑页顶部导航栏的 4 个常驻入口（v7.7）。

    showAsAction="always"：不放进溢出菜单，用户一眼可见、一点即达。
    标题（android:title）同时是 TalkBack 朗读的可访问名称 —— 图标按钮必须带名字。

    v8.3.0：顶栏底色改成"与编辑区同色"之后，图标不能再靠固定的白/黑固定值：
    矢量图统一填白（见 res/drawable/ic_action_*.xml），由 MainActivity.applyTopBarColors()
    在运行时按**编辑器的文字色** setTint —— 这一点很关键，
    否则浅色编辑器配色下白图标叠在白底上等于没有图标。
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_appearance"
        android:icon="@drawable/ic_action_appearance"
        android:title="@string/menu_appearance"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_webdav"
        android:icon="@drawable/ic_action_webdav"
        android:title="@string/menu_webdav"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_upload"
        android:icon="@drawable/ic_action_upload"
        android:title="@string/menu_upload_now"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_undo"
        android:icon="@drawable/ic_action_undo"
        android:title="@string/menu_undo"
        app:showAsAction="always" />

</menu>
