<?xml version="1.0" encoding="utf-8"?>
<!--
    WebDAV 同步设置页。外壳配色沿用设置页的 settings_* 颜色（深浅色模式自动适配）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    tools:ignore="Overdraw">
    <!--
        tools:ignore="Overdraw"：根布局必须有不透明背景，否则 targetSdk 35 边到边时
        系统栏区域会露出下层内容/闪黑（与设置页同理，是有意为之）。

        为什么外面要套一层 FrameLayout（而不是像设置页那样直接用 ScrollView 当根）：
        本页有输入框，需要把内容顶到输入法之上。insets 只能作用在根的 padding 上，
        而如果把 ime 高度加在 ScrollView 自己的 padding 上，**可视区域并不会变矮**
        （padding 在滚动内容里，键盘依旧盖住视口底部，聚焦的输入框仍可能被遮住）。
        套一层 FrameLayout 后，ime 的底部 padding 让 ScrollView 的高度真正变矮，
        ScrollView 自身的「可见范围」计算才正确，聚焦控件也才会被滚到键盘之上。
    -->

    <ScrollView
        android:id="@+id/sync_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_title"
                android:textColor="@color/settings_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sync_subtitle"
                android:textColor="@color/settings_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sync_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/sync_enable"
                android:textColor="@color/settings_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/sync_server_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sync_server_label"
                android:textColor="@color/settings_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/sync_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sync_server_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="2"
                android:textColor="@color/settings_text"
                android:textColorHint="@color/settings_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_server_examples"
                android:textColor="@color/settings_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/sync_file_name_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sync_file_name_label"
                android:textColor="@color/settings_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/sync_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sync_file_name_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/settings_text"
                android:textColorHint="@color/settings_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sync_username_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/sync_username"
                android:text="@string/sync_username_label"
                android:textColor="@color/settings_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/sync_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/settings_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sync_password_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/sync_password"
                android:text="@string/sync_password_label"
                android:textColor="@color/settings_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/sync_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/settings_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_password_hint"
                android:textColor="@color/settings_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/sync_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sync_save" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/settings_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sync_status_section"
                android:textColor="@color/settings_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!--
                v8.0.2：状态 / 诊断整块可复制。

                这里原来是一个裸 TextView。加诊断行之后用户要把这一整段交给开发者排查，
                截图和手抄都容易出错，因此改成一块「报告面板」：
                  * sync_status 设 textIsSelectable —— 长按出系统选择手柄与「复制/全选」；
                  * 右下「复制全部」按钮 —— 一次把整块文字放进剪贴板，给不熟悉选择手柄的用户兜底。
                复制出来的内容与屏幕上**逐字一致**（所见即所得），不额外拼接版本号/设备名，
                否则用户会怀疑「我复制的和看到的不一样」。
            -->
            <LinearLayout
                android:id="@+id/sync_status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_panel_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_status_never"
                    android:textColor="@color/settings_text"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sync_copy_hint"
                        android:textColor="@color/settings_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/sync_copy"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/sync_copy_all"
                        android:textColor="@color/settings_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/sync_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/settings_warning"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="⚠ 当前使用明文 http，口令与内容可能被网络中的他人读取"
                tools:visibility="visible" />

            <!--
                证书指纹同样是要交给别人核对/粘贴的字符串，顺手也设成可选中的
                （用户反馈过指纹只能靠手抄）。
            -->
            <TextView
                android:id="@+id/sync_tls_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/settings_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="服务器证书指纹：AB:CD:…"
                tools:visibility="visible" />

            <Button
                android:id="@+id/sync_trust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sync_trust_button"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/sync_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sync_now" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sync_behavior_hint"
                android:textColor="@color/settings_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
