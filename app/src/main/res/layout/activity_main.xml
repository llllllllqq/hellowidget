<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        系统栏那一条（状态栏 / 刘海 / 挖孔区域）。

        v7.7.1 的关键修复：顶部 inset 的**高度由这个占位视图承担**，
        而不是加在导航栏自己的 padding 上。颜色与导航栏相同，
        所以视觉上两者连成一条从屏幕顶端铺下来的整条顶栏。
        旧实现把 inset 当导航栏的 paddingTop，导航栏高度又固定 56dp，
        于是标题和按钮被挤到只剩几个像素高（线上事故，见
        V7.7.1_TOP_BAR_SQUEEZE_FIX.md）。

        v8.3.0：顶栏不再是固定的品牌紫，而是**与编辑区同色**（用户要求）。
        这里写的 @color/top_bar_default 只是"首帧兜底"（= 编辑器默认配色的浅色白 / 深色黑），
        真正的颜色由 MainActivity.applyTopBarColors() 按用户的编辑器配色涂上：
        浅色 / 深色模式各用各的那一组，用户改了编辑器背景色顶栏就跟着改。
    -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/top_bar_default" />

    <!--
        顶部导航栏（v7.7）：设置 / WebDAV 同步 / 立即上传 / 撤回 四个常驻入口，
        菜单定义在 res/menu/main_menu.xml，由 MainActivity.onCreateOptionsMenu 装载。
        原先占据屏幕底部的两个按钮已删除（用户要求全部上移）。

        高度固定为 @dimen/top_bar_height（56dp）：它的内容区高度因此**与系统栏 inset 无关**，
        标题与 4 个按钮在任何设备上都有完整高度可用。

        v8.3.0：底色 + 标题色 + 图标 tint 全部在运行时按编辑器配色设置
        （MainActivity.applyTopBarColors）。因此这里既不需要
        `android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"`（那是"紫底白字"的
        配套覆盖层，底色一换它就成了错误的默认值：白底上白图标等于没有图标），
        也不需要 app:popupTheme —— 工具栏直接继承 Activity 主题，浅色 / 深色各自正确。
    -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/top_bar_default" />

    <!--
        编辑区。这里的 android:textSize 只是布局预览与首帧的兜底值：
        运行时由 MainActivity 按设置页里的「字体大小」重设为同一个 sp 值
        （见 MainActivity.applyEditorAppearance）。
    -->
    <ScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <EditText
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="start|top"
            android:hint="@string/editor_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:isScrollContainer="false"
            android:padding="16dp"
            android:textSize="16sp" />

    </ScrollView>

</LinearLayout>
