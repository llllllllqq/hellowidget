    <!-- ===== WebDAV sync (v7.2) ===== -->
    <string name="sync_title">WebDAV sync</string>
    <string name="sync_subtitle">Uploads your latest content to your own WebDAV. Automatic sync only uploads — the cloud copy never overwrites this device.</string>
    <string name="sync_enable">Enable WebDAV sync</string>
    <string name="sync_server_label">Server directory URL</string>
    <string name="sync_server_hint">https://dav.example.com/dav/hellowidget/</string>
    <string name="sync_server_examples">Nextcloud: https://your-host/remote.php/dav/files/&lt;user&gt;/&lt;folder&gt;/\nSynology/NAS: http://192.168.1.5:5005/dav/&lt;folder&gt;/ (plain http is flagged as risky)\nThe URL must point to a directory and end with /; do not put the user name or password in it.</string>
    <string name="sync_file_name_label">File name (prefix + extension)</string>
    <string name="sync_file_name_hint">note.txt</string>
    <string name="sync_username_label">User name</string>
    <string name="sync_password_label">Password</string>
    <string name="sync_password_hint">An app-specific password is recommended so it can be revoked on its own. It is stored in the app-private directory and is excluded from cloud backup and device transfer.</string>
    <string name="sync_save">Save settings</string>
    <string name="sync_now">Sync now (ignores the 1-minute limit)</string>
    <string name="sync_trust_button">Trust and remember this certificate fingerprint</string>
    <string name="sync_status_section">Sync status</string>
    <string name="sync_behavior_hint">Sync timing: uploads happen only when content is saved (exit/back, going to the background, plus the automatic saves triggered by rotation or a dark-mode switch), and automatic uploads are at least 1 minute apart. Opening the app only checks whether anything changed locally since the last successful upload — if so, an orange dot lights up on the "Upload to cloud now" button, and nothing is uploaded. "Sync now" is not limited. A progress notification is shown while syncing and removed the moment it ends — no background task is left behind.</string>
    <string name="sync_upload_not_ready">WebDAV sync is off or not fully configured — open “WebDAV sync” and set it up first</string>
    <string name="sync_state_enabled">Status: enabled</string>
    <string name="sync_state_disabled">Status: disabled</string>
    <string name="sync_effective_url">Writes to: %1$s</string>
    <string name="sync_history_note">Every upload creates a new file with a unix timestamp; older files are left untouched (the cloud keeps the full history)</string>
    <string name="sync_status_never">Never synced yet</string>
    <string name="sync_status_success">Last sync succeeded: %1$s</string>
    <!-- v8.0.1: distinguish "really uploaded" from "nothing changed, no request sent" (both store result=success) -->
    <string name="sync_status_success_uploaded">Last upload to the cloud: %1$s</string>
    <string name="sync_status_success_noop">Last sync succeeded but nothing changed locally, so nothing was uploaded (no request was sent): %1$s</string>
    <string name="sync_upload_succeeded">Uploaded to WebDAV</string>
    <string name="sync_failed_toast">Upload failed: %1$s</string>
    <string name="sync_status_failed">Last sync failed: %1$s %2$s</string>
    <string name="sync_status_running">Syncing…</string>
    <string name="sync_skip_disabled">Sync is disabled — skipped</string>
    <string name="sync_skip_not_configured">Settings are incomplete — skipped</string>
    <string name="sync_skip_throttled">Less than 1 minute since the last sync — skipped (changes go up at the next allowed moment or via "Sync now")</string>
    <string name="sync_time_never">never</string>
    <string name="sync_last_attempt">Last attempt: %1$s</string>
    <string name="sync_retry_queued">Automatic retry: queued (a save arms a system fallback; if the content is already in the cloud the job sends no request)</string>
    <string name="sync_retry_none">Automatic retry: none (nothing pending)</string>
    <string name="sync_retry_exhausted">Automatic retry: all %1$d automatic attempts used, changes are still not uploaded — tap \"Sync now\" or save again</string>
    <!-- v8.0.1 diagnostics: the value is an ASCII token identical to logcat, so it can be copied as-is -->
    <string name="sync_last_launch">Last auto-upload channel: %1$s (%2$s)</string>
    <string name="sync_diagnostics">System diagnostics: %1$s</string>
    <string name="sync_cleartext_warning">⚠ Plain http is in use: your password and notes travel unencrypted and can be read by others on the same network. Use https when possible (self-signed certificates can be pinned below).</string>
    <string name="sync_tls_pending">Server certificate fingerprint (not trusted yet): %1$s</string>
    <string name="sync_tls_trusted">Trusted certificate fingerprint: %1$s</string>
    <string name="sync_trust_dialog_title">Trust this server certificate?</string>
    <string name="sync_trust_dialog_message">Server certificate fingerprint:\n%1$s\n\nOnly trust it if you are sure it belongs to your own server. Afterwards only this fingerprint is accepted, and a changed fingerprint asks for confirmation again.</string>
    <string name="sync_trust_confirm">Trust and remember</string>
    <string name="sync_trusted">Fingerprint remembered</string>

    <!-- WebDAV sync: notifications -->
