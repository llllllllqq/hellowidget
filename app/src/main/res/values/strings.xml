    <!-- ===== WebDAV 同步（v7.2） ===== -->
    <string name="sync_title">WebDAV 同步</string>
    <string name="sync_subtitle">把最新内容上传到你自己的 WebDAV。自动同步只上传，绝不用云端内容覆盖本机。</string>
    <string name="sync_enable">启用 WebDAV 同步</string>
    <string name="sync_server_label">服务器目录地址</string>
    <string name="sync_server_hint">https://dav.example.com/dav/hellowidget/</string>
    <string name="sync_server_examples">坚果云：https://dav.jianguoyun.com/dav/你的目录/\nNextcloud：https://你的域名/remote.php/dav/files/用户名/目录/\n局域网 NAS：http://192.168.1.5:5005/dav/目录/（明文 http 会被警告）\n地址要指向「目录」并以 / 结尾；不要在地址里写用户名和口令。</string>
    <string name="sync_file_name_label">文件名（前缀 + 扩展名）</string>
    <string name="sync_file_name_hint">note.txt</string>
    <string name="sync_username_label">用户名</string>
    <string name="sync_password_label">口令</string>
    <string name="sync_password_hint">建议在 WebDAV 侧生成「应用专用密码」，便于随时单独吊销。口令只存在应用私有目录，且已被排除在系统备份与换机迁移之外。</string>
    <string name="sync_save">保存设置</string>
    <string name="sync_now">立即同步（不受 1 分钟限制）</string>
    <string name="sync_trust_button">信任并记住此证书指纹</string>
    <string name="sync_status_section">同步状态</string>
    <string name="sync_behavior_hint">同步时机：关闭编辑器后、打开应用时（上次未成功才补）。自动同步两次之间至少间隔 1 分钟，避免被服务器限流；「立即同步」不受限制。同步期间通知栏显示进度条，结束后立即停止，不留下任何常驻后台任务。</string>
    <string name="sync_upload_not_ready">未启用或未完整配置 WebDAV 同步，请先打开「WebDAV 同步」设置</string>
    <string name="sync_state_enabled">状态：已启用</string>
    <string name="sync_state_disabled">状态：未启用</string>
    <string name="sync_effective_url">云端写入：%1$s</string>
    <string name="sync_history_note">每次上传都会新建一个带 unix 时间戳的文件，旧文件保持原样（云端自动保留全部历史）</string>
    <string name="sync_status_never">尚未同步过</string>
    <string name="sync_status_success">上次同步成功：%1$s</string>
    <string name="sync_upload_succeeded">已上传到云端</string>
    <string name="sync_status_failed">上次同步失败：%1$s %2$s</string>
    <string name="sync_status_running">正在同步…</string>
    <string name="sync_skip_disabled">未启用同步，本次跳过</string>
    <string name="sync_skip_not_configured">设置不完整，本次跳过</string>
    <string name="sync_skip_throttled">距上次同步不足 1 分钟，本次跳过（改动会在下次允许时机或点击「立即同步」时上传）</string>
    <string name="sync_time_never">从未</string>
    <string name="sync_cleartext_warning">⚠ 当前使用明文 http：口令与笔记内容会以未加密方式经过网络，同一网络中的他人可能读取。条件允许时请改用 https（自建证书可在下方信任指纹）。</string>
    <string name="sync_tls_pending">服务器证书指纹（尚未信任）：%1$s</string>
    <string name="sync_tls_trusted">已信任证书指纹：%1$s</string>
    <string name="sync_trust_dialog_title">信任服务器证书？</string>
    <string name="sync_trust_dialog_message">服务器证书指纹：\n%1$s\n\n只有在你确认这就是自己服务器的证书时才应信任。信任后本应用只接受该指纹的证书，指纹变化会再次要求确认。</string>
    <string name="sync_trust_confirm">信任并记住</string>
    <string name="sync_trusted">已记住该证书指纹</string>

