<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色模式下的设置页配色（仅页面外壳，小组件本身颜色不受影响） -->
    <color name="settings_bg">#121212</color>
    <color name="settings_text">#E6E6E6</color>
    <color name="settings_secondary">#9E9E9E</color>
    <color name="settings_divider">#333333</color>
    <!-- 深色模式下用更亮的红，保证在深色背景上依然清晰 -->
    <color name="settings_warning">#FF8A80</color>
    <!--
        v8.0.2：同步页状态/诊断面板底色。
        比页面底色 #121212 略亮：深色模式下不能靠加深来分块（会糊成一片），要靠明度差。
    -->
    <color name="settings_panel">#1E1E1E</color>
    <!-- v8.3.0：深色模式下顶栏的首帧兜底值 = 编辑器默认配色的深色背景（黑），见 values/colors.xml -->
    <color name="top_bar_default">#FF000000</color>
</resources>
